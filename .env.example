ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ragdb
# Note: OPENAI_API_KEY is no longer required — embedder is self-hosted
# Qwen/Qwen3-Embedding-0.6B via sentence-transformers (see README).

# ---------------------------------------------------------------------------
# Optional tuning (defaults in code work; override here for constrained envs)
# ---------------------------------------------------------------------------
# Embedder device: "cpu" (default, fp32 batch 16) or "cuda" (fp16 batch 16, requires GPU)
# EMBED_DEVICE=cuda
# EMBED_BATCH=4
# EMBED_DTYPE=float16
#
# Chart-extraction vision throttle (Anthropic Tier 1 RPM safety, default 1.4s)
# VISION_MIN_INTERVAL_SECONDS=1.4
#
# CUDA allocator: enable expandable_segments to reduce fragmentation OOMs on
# constrained GPUs (e.g. WSL2 with shared host memory).
# Must be exported in your shell BEFORE launching Python
# (PyTorch reads it at import time, not from a .env file). Example:
#   export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
